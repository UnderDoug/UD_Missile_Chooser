  </command>
  <command ID="Cmd_UD_LastMissile" DisplayText="Select last fired missile weapon" Category="Popup" Layer="UI" Auto="Down">
    <keyboardBind Key="r"/>
    <gamepadBind Button="rightStickPress"/>
  </command>
</commands>